# Conservá VITE_API_URL de tu .env actual.
# ID público del cliente OAuth web, igual al ClientId configurado en el backend.
# No colocar un Client Secret en el front.
VITE_GOOGLE_CLIENT_ID=

# Activar únicamente después de proteger los endpoints de pedidos por propietario.
VITE_CUSTOMER_ORDERS_ENABLED=false

# Mantiene Armá tu PC en Próximamente. true habilita selección y comparación orientativa.
VITE_PC_BUILDER_ENABLED=false
